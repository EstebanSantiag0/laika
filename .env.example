# Secrets for the Laika app. Copy to .env, chmod 600, never commit.

# Tailscale login allowed to use the web app (from the Tailscale-User-Login header; empty = any tailnet user)
ALLOWED_TS_LOGIN=

# Telegram bot (from @BotFather) and your numeric Telegram user ID (only this user is answered)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Optional: Laika's own Telegram user account instead of a bot (TELEGRAM_MODE=user).
# API ID/hash from my.telegram.org; log in once with: docker compose exec app python -m laika.tg_login send
TELEGRAM_MODE=bot
TG_API_ID=
TG_API_HASH=
TG_PHONE=
